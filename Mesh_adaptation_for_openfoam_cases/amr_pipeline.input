&amr_input
  ! ============================================================
  ! OpenFOAM Mach 3 cylinder at 50 km altitude
  !
  ! This single input file serves two workflows:
  !
  !   1. Mesh-only demo (no solver) — generate_amr_mesh.sh reads the
  !      bundled OpenFOAM result and produces the AMR mesh with Gmsh.
  !      Needs only Gmsh and ParaView.
  !
  !   2. Full pipeline (solver in the loop) — ../master_script/all_run.sh
  !      runs rhoCentralFoam through run_openfoam.sh / run_openfoam_amr.sh
  !      for the configured number of AMR loops.  Needs OpenFOAM v2406.
  !
  ! Edit the binary paths and foam_source for your machine; the scripts
  ! themselves do not need to be edited.
  ! ============================================================

  ! --- Pipeline settings ---
  loops              = 3
  gmsh_bin           = /home/fahim.shahriyar/gmsh/gmsh-4.11.1-Linux64/bin/gmsh
  pvpython           = /home/fahim.shahriyar/dsmc/Paraview/ParaView-5.13.2-MPI-Linux-Python3.10-x86_64/bin/pvpython

  ! --- Geometry and mesh filenames ---
  geo_file           = mach3_cylinder.geo
  geo_file_amr       = mach3_cylinder_amr.geo
  sim_mesh           = mach3_cylinder.msh
  sim_mesh_amr       = mach3_cylinder_amr.msh

  ! --- Solver run scripts ---
  ! run_openfoam.sh and run_openfoam_amr.sh are bundled in this folder
  ! (a copy of the shared master_script wrappers) so the case runs
  ! self-contained, the same way as dsmc/openfoam_mach3_cylinder.
  case_script        = run_openfoam.sh
  case_script_amr    = run_openfoam_amr.sh
  final_py           = ../master_script/final.py

  ! --- Bundled solver result that drives the mesh-only demo ---
  pvd_file           = precomputed_result/field/auto_field.pvd

  ! --- Field extraction (gradient mode for CFD) ---
  ! 'gradient' mode computes |grad(gradient_field)| from the VTU output
  ! and applies the sizing formula
  !     h = sizing_min + (sizing_max - sizing_min)
  !         / (1 + sizing_scale * |grad f| / max |grad f|)
  ! to produce a per-point cell-size field at mfp.pos.
  extraction_mode    = gradient
  gradient_field     = p
  sizing_min         = 0.002
  sizing_max         = 0.015
  sizing_scale       = 100.0
  mfp_column         = p_sizing
  pos_scale          = 1.0

  ! --- OpenFOAM solver settings (full pipeline only) ---
  foam_source        = /home/fahim.shahriyar/OpenFOAM/OpenFOAM-v2406/etc/bashrc
  solver             = rhoCentralFoam
  case_dir           = openfoam_case
  boundary_fix       = frontAndBack:empty, wall:wall
  foam_sigfpe        = false

  ! --- Output settings ---
  partition_mesh     = false
  pv_output_dir      = field
  pvd_create         = true
  raw_csv            = all_data.csv
  filtered_csv       = filtered_mfp.csv
  pos_file           = mfp.pos
/
